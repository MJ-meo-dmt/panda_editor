# -----------------------------------------------------------------------------
# Panda Editor POC - repository hygiene
# -----------------------------------------------------------------------------

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments
venv/
.venv/
env/
ENV/

# Panda Editor generated/cache data
.panda_editor/
.panda_export/
build_exports/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Logs / crash / temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# Local environment/config secrets
.env
.env.*
!.env.example

# IDE / editor-local state
.vscode/
.vscodium/
.idea/
*.code-workspace

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# IMPORTANT: default/reference project content is intentionally versioned.
# Do not ignore the project assets, templates, scripts, shaders or UI sources.
# -----------------------------------------------------------------------------
!assets/
!assets/**
!project_templates/
!project_templates/**
!scripts/
!scripts/**
!ui/
!ui/**
